# PULSE AI configuration. Copy to .env (never commit .env).

# auto (default): Foundry when configured and a credential resolves, otherwise demo.
# demo: deterministic local outputs, no model calls.  foundry: require Foundry, fail if unavailable.
PULSE_AI_MODE=auto

# Microsoft Foundry project endpoint, format:
# https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=
# Model deployment name in that project (e.g. gpt-5-mini, gpt-4.1-mini)
FOUNDRY_MODEL=

# Authentication: no key is needed. The backend uses azure-identity in this order:
#   EnvironmentCredential (AZURE_CLIENT_ID / AZURE_TENANT_ID / AZURE_CLIENT_SECRET), AzureCliCredential (`az login`),
#   ManagedIdentityCredential, DefaultAzureCredential.
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=

# Optional: Foundry groundedness evaluator (azure-ai-evaluation needs an Azure OpenAI style endpoint).
ENABLE_GROUNDEDNESS_EVALUATOR=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
FOUNDRY_EVAL_MODEL=

AI_TIMEOUT_SECONDS=40
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public deployment guardrails (0 = off; the Azure deploy script sets 400 and 30). See docs/deployment.md.
PULSE_AI_DAILY_CALL_BUDGET=0
PULSE_AI_IP_LIMIT_PER_HOUR=0
